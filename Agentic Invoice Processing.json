    {
      "parameters": {
        "jsCode": "const returnItems = [];\n\nfor (const item of $input.all()) {\n  const body = item.json;\n  const binaryData = item.binary || {};\n  \n  const fileKeys = Object.keys(binaryData);\n  \n  // Safely grab the ID from the new Gmail structure\n  const refId = body.messageId || body.id || \"EMAIL-\" + Date.now();\n  \n  // Safely grab the sender's email address from the nested 'from' object\n  let sender = \"Unknown Sender\";\n  if (body.from && body.from.text) {\n      sender = body.from.text;\n  } else if (body.From) {\n      sender = body.From;\n  }\n  \n  // Check if an attachment actually exists\n  if (fileKeys.length === 0) {\n    returnItems.push({\n      json: { is_valid: false, error_message: \"Validation Failed: No file attached\", reference_id: refId }\n    });\n    continue;\n  }\n  \n  // Identify and grab the first attachment\n  const fileKey = fileKeys[0];\n  const file = binaryData[fileKey];\n  \n  // Validate the file type\n  const allowedMimeTypes = ['application/pdf', 'image/png', 'image/jpeg', 'image/jpg', 'text/plain'];\n  if (!allowedMimeTypes.includes(file.mimeType)) {\n    returnItems.push({\n      json: { is_valid: false, error_message: \"Validation Failed: Invalid file type\", reference_id: refId }\n    });\n    continue;\n  }\n  \n  // Pass the data downstream and rename the file to \"invoice_document\"\n  returnItems.push({\n    json: {\n      is_valid: true,\n      reference_id: refId,\n      source_system: sender,\n      file_name: file.fileName,\n      mime_type: file.mimeType\n    },\n    binary: {\n      invoice_document: file\n    }\n  });\n}\n\nreturn returnItems;"
      },
