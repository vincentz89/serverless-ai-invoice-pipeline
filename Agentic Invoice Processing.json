    {
      "parameters": {
        "jsCode": "// Grab the entire incoming item (JSON and binary)\nconst item = $input.first();\nconst data = item.json; \nconst invoice = data.output;\n\n// --- AUDIT CHECKS ---\nlet auditFlags = [];\n\n// Check A: Missing Invoice Number\n// (Triggers if it is null, undefined, or just an empty string)\nif (!invoice.invoice_number || String(invoice.invoice_number).trim() === \"\") {\n    auditFlags.push(\"MISSING_INVOICE_NUMBER\");\n}\n\n// Check B: Math Validation\nif (invoice.subtotal && invoice.tax_amount && invoice.total_amount) {\n    const calculatedTotal = invoice.subtotal + invoice.tax_amount;\n    if (calculatedTotal !== invoice.total_amount) {\n        auditFlags.push(\"MATH_MISMATCH\");\n    }\n}\n\n// If any errors were caught, combine them into the audit_flag field\nif (auditFlags.length > 0) {\n    data.audit_flag = auditFlags.join(\" | \");\n} else {\n    data.audit_flag = null; \n}\n\n// --- RE-ATTACH BINARY FILE ---\nitem.binary = $('Validate Input').first().binary;\n\nreturn item;"
      },
